# Set automatically by ops/deploy.sh. Use a distinct value for a parallel deployment.
NYMBLE_DEPLOY_NAME=nymble

# Set automatically by ops/deploy.sh. Do not change this manually.
NYMBLE_IMAGE_TAG=nymble:initial

# Host port for Nymble. The container always listens on port 3100.
NYMBLE_HOST_PORT=3100

LEAK_DETECTION_ENABLED=true
LEAK_DETECTION_PROVIDER=presidio
PRESIDIO_DEFAULT_LANGUAGE=en
PRESIDIO_SUPPORTED_LANGUAGES=en
PRESIDIO_SCORE_THRESHOLD=0.5
PRESIDIO_IGNORED_ENTITIES=DATE_TIME
